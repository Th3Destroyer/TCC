# Defina estas variáveis no shell ou no seu gerenciador de processos.
# O Django não carrega arquivos .env automaticamente.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# Obrigatória quando DJANGO_DEBUG=0. Gere uma chave própria, sem publicá-la.
# DJANGO_SECRET_KEY=
# DJANGO_DB_PATH=/caminho/para/db.sqlite3
# DJANGO_CSRF_TRUSTED_ORIGINS=https://suporte.exemplo.gov.br
# DJANGO_SECURE_COOKIES=1
